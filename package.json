{
  "name": "@aefree/pi-project-artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical project Markdown artifact search and atomic file-todo lifecycle tools with versioned provider contracts.",
  "type": "module",
  "sideEffects": false,
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./dist/pi/index.js"],
    "skills": ["./skills"]
  },
  "license": "MIT",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./contracts": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
    "./contracts/v1": { "types": "./dist/contracts/v1/index.d.ts", "import": "./dist/contracts/v1/index.js" },
    "./contracts/v1/conformance": { "types": "./dist/contracts/v1/conformance.d.ts", "import": "./dist/contracts/v1/conformance.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./pi": { "types": "./dist/pi/index.d.ts", "import": "./dist/pi/index.js" }
  },
  "files": ["dist", "src", "skills", "evals", "CHANGELOG.md", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@aefree/pi-capability-registry": "^0.1.0" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.8",
    "typescript": "^5.8.3"
  },
  "repository": { "type": "git", "url": "git+ssh://git@github.com/aefreedman/pi-project-artifacts.git" },
  "bugs": { "url": "https://github.com/aefreedman/pi-project-artifacts/issues" },
  "homepage": "https://github.com/aefreedman/pi-project-artifacts#readme"
}
